{
  "name": "phish-out-of-water",
  "version": "0.1.0",
  "description": "An AI agent that opens suspicious links inside a disposable sandbox on Vultr and tells you, in plain language, whether it is a scam.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:broker": "node dist/broker.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sandbox:build": "docker build -t phish-out-of-water/detonator:latest sandbox"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "fastify": "^5.12.8",
    "tldts": "^6.1.86"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "5.7",
    "vitest": "^2.1.9"
  }
}
