[Unit]
Description=Phish Out of Water - suspicious link inspector
# The app has no Docker access: it asks the detonation broker, through its socket, to open links.
After=network-online.target pootw-detonation-broker.service
Wants=network-online.target pootw-detonation-broker.service
# Never give up restarting: the demo must come back on its own after any crash or reboot.
StartLimitIntervalSec=0

[Service]
User=phishoutofwater
Group=phishoutofwater
SupplementaryGroups=pootw-broker-clients
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=/usr/bin/node __APP_DIR__/dist/main.js
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
