# HTTP
PORT=8080

# Vultr Serverless Inference (OpenAI-compatible)
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Must accept image input. See https://api.vultrinference.com/v1/models
VULTR_VISION_MODEL=qwen3.8-flash-next
VULTR_REPORT_MODEL=qwen3.8-flash-next

# Disposable sandbox
SANDBOX_IMAGE=phish-out-of-water/detonator:latest
# Dedicated Docker network whose egress to private ranges is blocked (see deploy/setup-sandbox-network.sh)
SANDBOX_NETWORK=pootw-sandbox
# Optional: "runsc" to run every detonation under gVisor
SANDBOX_RUNTIME=
# Optional: resolv.conf mounted into each sandbox. Required with runsc, which cannot use Docker's embedded DNS.
SANDBOX_RESOLV_CONF=
# Chromium's own sandbox inside each container ("enabled" by default). It needs gVisor (runsc);
# set "disabled" only for local development on Docker's default runtime.
SANDBOX_CHROMIUM_SANDBOX=enabled
SANDBOX_TIMEOUT_SECONDS=75
MAX_CONCURRENT_INSPECTIONS=2
